2026-08-22 18:31:13,365 2597848 DEBUG mcpp.tool CALL plan_area_new args={'items': [{'name': 'boot-and-identity', 'description_md': 'Come up knowing what this board is and where it is: role derived from VBUS, site from a persisted command, names and position seeded from it. DONE when a unit cannot be deployed claiming somewhere it is not.'}, {'name': 'sleep-and-wake', 'description_md': 'Sleep to a schedule and wake when it said it would: the beat, the anchored next-wake, silent beats, and the announce/listen/drain order of one wake. DONE when a listener can predict a wake and hit it.'}, {'name': 'energy', 'description_md': "What is energised, and what a run costs: rails, pins, battery and the coulomb counter. DONE when we can state a unit's draw and its remaining life from the unit itself."}, {'name': 'radio-link', 'description_md': 'Drive the modem so a frame handed to it actually radiates: CAD, CSMA backoff, the TX state machine, RX arming, receiver gain, and the Meshtastic header on the wire. DONE when txdone means transmitted and nothing wedges the queue.'}, {'name': 'mesh-crypto', 'description_md': 'Keep traffic private on a shared channel: AES-CCM on the channel key, and per-peer PKI keys with the exchange that learns them. DONE when a wrong or changed key is detected rather than silently mis-decoded.'}, {'name': 'peer-directory', 'description_md': 'Remember who is out there: the node table, names, public keys, protection and ageing. DONE when the table is a true account of the mesh and cannot evict a peer mid-exchange.'}, {'name': 'command-surface', 'description_md': 'Accept an addressed verb, dispatch it, and answer inside the wire budget: the 35-verb dispatcher, argument bounds, refusals that say why, and the USB console on the same grammar. DONE when every verb answers in the shape a caller expects, or refuses.'}, {'name': 'telemetry', 'description_md': 'Say what the unit is doing without being asked, and prove delivery: obs, device and environment metrics, and the receipts rxid, ans and rxms. DONE when a listener can tell arrival from execution from silence.'}, {'name': 'frame-codec', 'description_md': 'Put a frame on the air that decodes to what was meant: the packed codec, the presence bitmap, the wire hash, and a human label for every field. DONE when a schema change cannot silently misalign a deployed decoder.'}, {'name': 'settings', 'description_md': 'A setting survives a reboot, inside its bounds, and an older on-disk record still loads: the config store, clamping, and the migration cascade. DONE when a record from any earlier era migrates or is refused loudly.'}, {'name': 'detection', 'description_md': 'Notice what the device exists to notice: PIR motion, environment change, and dispatching an alarm from it. DONE when a real trigger reliably becomes an alarm and a false one does not.'}, {'name': 'lifecycle', 'description_md': 'Compose every module and dispatch what arrives: setup, the loop, the packet router, and the wiring between the mt-* libraries. The composition root that most other areas watch. DONE when every module constructed is begun and every arriving portnum is handled.'}]}
